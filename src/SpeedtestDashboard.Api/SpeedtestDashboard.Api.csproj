<Project Sdk="Microsoft.NET.Sdk.Web">

  <ItemGroup>
    <ProjectReference Include="..\SpeedtestDashboard.Core\SpeedtestDashboard.Core.csproj" />
    <ProjectReference Include="..\SpeedtestDashboard.Infrastructure\SpeedtestDashboard.Infrastructure.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.11">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RuntimeIdentifiers>linux-x64;linux-arm64</RuntimeIdentifiers>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <FrontendDist Condition="'$(FrontendDist)' == ''">$(MSBuildProjectDirectory)/__frontend_not_supplied__</FrontendDist>
  </PropertyGroup>

  <ItemGroup Condition="Exists('$(FrontendDist)')">
    <Content Include="$(FrontendDist)/**/*" Link="wwwroot/%(RecursiveDir)%(Filename)%(Extension)" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup Condition="'$(Configuration)' == 'Release'">
    <Content Update="appsettings.Development.json" CopyToPublishDirectory="Never" />
  </ItemGroup>

  <Target Name="EnsureWebRootExists" BeforeTargets="Build">
    <MakeDir Directories="$(MSBuildProjectDirectory)/wwwroot" />
  </Target>

</Project>
