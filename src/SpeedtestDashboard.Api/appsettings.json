{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "System.Net.Http.HttpClient": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ReverseProxy": {
    "TrustForwardedHeaders": false
  },
  "Authentication": {
    "AllowInsecureHttp": false,
    "DataProtectionPath": "/data/dataprotection"
  },
  "NetworkIdentity": {
    "SuccessCacheSeconds": 300,
    "FailureCacheSeconds": 30,
    "RefreshThrottleSeconds": 10,
    "RequestTimeoutSeconds": 5,
    "MetadataProvider": "none"
  },
  "SpeedTests": {
    "QueueCapacity": 4,
    "QueueFullRetryAfterSeconds": 5,
    "SseHeartbeatSeconds": 20
  },
  "Processes": {
    "DefaultTimeoutSeconds": 120,
    "MaxTimeoutSeconds": 600,
    "DefaultStdoutLimitBytes": 2097152,
    "DefaultStderrLimitBytes": 1048576,
    "AbsoluteOutputLimitBytes": 8388608
  },
  "Providers": {
    "LibreSpeed": {
      "ExecutablePath": "/usr/local/bin/librespeed-cli",
      "Enabled": true,
      "HealthTimeoutSeconds": 5,
      "HealthCacheSeconds": 45,
      "TestTimeoutSeconds": 180,
      "ServerListTimeoutSeconds": 20,
      "ServerCacheSeconds": 300,
      "MaximumServers": 250,
      "DisableIcmp": true,
      "PreferHttps": true
    },
    "Ookla": {
      "ExecutablePath": "/usr/bin/speedtest",
      "Enabled": true,
      "AcceptLicense": false,
      "AcceptGdpr": false,
      "HealthTimeoutSeconds": 5,
      "HealthCacheSeconds": 45,
      "TestTimeoutSeconds": 180,
      "ServerListTimeoutSeconds": 30,
      "ServerCacheSeconds": 300,
      "MaximumServers": 100
    }
  },
  "Storage": {
    "DatabasePath": "/data/speedtest.db",
    "CommandTimeoutSeconds": 10
  }
}
